# Project
EXPO_PUBLIC_PROJECT_WEBSITE_URL=http://localhost:8081

# Sentry
EXPO_PUBLIC_SENTRY_ORGANIZATION=your-organization
EXPO_PUBLIC_SENTRY_PROJECT=your-project-name
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
EXPO_PUBLIC_SENTRY_URL=https://sentry.io/
EXPO_PUBLIC_SENTRY_TRACES_SAMPLER=1
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_ENABLED=false

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API (production values go in .env.production, which is git-ignored; see README "Production")
EXPO_PUBLIC_API_URL=http://your-api-host:1009/api

# E2E (Maestro, runs only on the owner's Mac)
E2E_ENABLED=false
E2E_WEB_URL=http://localhost:8081
E2E_API_URL=http://localhost:3000/api
EXPO_PUBLIC_E2E_LOGIN=false
